      "vatId": {
        "title": "VAT ID",
        "type": [
          "string",
          "null"
        ],
        "description": "Normalized VAT number with country prefix.",
        "examples": [
          "IE6388047V"
        ]
      },
      "status": {
        "title": "Status",
        "type": [
          "string",
          "null"
        ],
        "description": "valid, invalid (not registered for intra-EU trade), invalid_format (checked locally, not sent), unsupported_country (e.g. GB, CH), service_unavailable (member state offline; retry later), invalid_input, error, skipped_charge_limit. Only valid and invalid are charged.",
        "examples": [
          "valid"
        ]
      },
      "valid": {
        "title": "Valid?",
        "type": [
          "boolean",
          "null"
        ],
        "description": "true if VIES says the number is valid today.",
        "examples": [
          true
        ]
      },
      "name": {
        "title": "Registered name",
        "type": [
          "string",
          "null"
        ],
        "description": "Name from VIES (some countries, e.g. DE, return none).",
        "examples": [
          "GOOGLE IRELAND LIMITED"
        ]
      },
      "address": {
        "title": "Registered address",
        "type": [
          "string",
          "null"
